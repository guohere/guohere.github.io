---
import { SITE } from '../data/profile';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const navItems = [
  { href: '/', en: 'Home', de: 'Startseite' },
  { href: '/blog/', en: 'Blog', de: 'Blog' },
  { href: '/projects/', en: 'Projects', de: 'Projekte' },
  { href: '/#experience', en: 'Experience', de: 'Erfahrung' },
  { href: '/#contact', en: 'Contact', de: 'Kontakt' },
];

function isActive(href: string, path: string): boolean {
  if (href === '/') return path === '/' || path === '';
  if (href.startsWith('/#')) return false;
  return path.startsWith(href);
}
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label={`${SITE.title} — Home`}>
      <span class="brand-mark" aria-hidden="true">XG</span>
      <span class="brand-name">{SITE.title}</span>
    </a>

    <nav class="nav-desktop" aria-label="Primary navigation">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={['nav-link', { 'nav-link--active': isActive(item.href, currentPath) }]}
          aria-current={isActive(item.href, currentPath) ? 'page' : undefined}
        >
          <span class="lang-en">{item.en}</span>
          <span class="lang-de">{item.de}</span>
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <button
        id="lang-toggle"
        type="button"
        class="lang-btn"
        aria-label="Switch language between English and German"
        title="Switch language (EN / DE)"
      >
        <span class="lang-opt lang-opt--en">EN</span>
        <span class="lang-sep" aria-hidden="true">/</span>
        <span class="lang-opt lang-opt--de">DE</span>
      </button>

      <button
        id="theme-toggle"
        type="button"
        class="icon-btn"
        aria-label="Toggle color theme"
        title="Toggle light or dark theme"
      >
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
        </svg>
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>

      <button
        id="mobile-menu-toggle"
        type="button"
        class="icon-btn mobile-only"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="nav-mobile" aria-label="Mobile navigation" hidden>
    <div class="container nav-mobile-inner">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={['nav-mobile-link', { 'nav-link--active': isActive(item.href, currentPath) }]}
        >
          <span class="lang-en">{item.en}</span>
          <span class="lang-de">{item.de}</span>
        </a>
      ))}
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .header-inner {
    height: var(--nav-height);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--ink);
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .brand:hover {
    color: var(--ink);
  }

  .brand-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 7px;
    background-color: var(--ink);
    color: var(--bg);
    font-family: var(--font-serif);
    font-size: 0.88rem;
    font-weight: 500;
    letter-spacing: -0.03em;
  }

  .brand-name {
    font-size: 0.98rem;
  }

  .nav-desktop {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .nav-link {
    padding: 0.42rem 0.78rem;
    border-radius: var(--radius-sm);
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--ink-secondary);
    transition: color var(--transition), background-color var(--transition);
  }

  .nav-link:hover {
    color: var(--ink);
    background-color: var(--surface-subtle);
  }

  .nav-link--active {
    color: var(--ink);
    background-color: var(--surface-subtle);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .lang-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    height: 36px;
    padding: 0 0.65rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background-color: var(--surface);
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 500;
    cursor: pointer;
    transition: border-color var(--transition), color var(--transition);
  }

  .lang-btn:hover {
    border-color: var(--border-strong);
  }

  .lang-sep {
    opacity: 0.45;
  }

  :global(:root[data-lang='en']) .lang-opt--en,
  :global(:root:not([data-lang='de'])) .lang-opt--en,
  :global(:root[data-lang='de']) .lang-opt--de {
    color: var(--ink);
    font-weight: 700;
  }

  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background-color: var(--surface);
    color: var(--ink-secondary);
    cursor: pointer;
    transition: color var(--transition), border-color var(--transition), background-color var(--transition);
  }

  .icon-btn:hover {
    color: var(--ink);
    border-color: var(--border-strong);
  }

  .icon-sun {
    display: none;
  }

  :global(:root[data-theme='dark']) .icon-sun {
    display: block;
  }

  :global(:root[data-theme='dark']) .icon-moon {
    display: none;
  }

  .mobile-only {
    display: none;
  }

  .nav-mobile {
    border-top: 1px solid var(--border);
    background-color: var(--bg);
  }

  .nav-mobile-inner {
    display: flex;
    flex-direction: column;
    padding-top: 0.6rem;
    padding-bottom: 1rem;
    gap: 0.25rem;
  }

  .nav-mobile-link {
    padding: 0.65rem 0.75rem;
    border-radius: var(--radius-sm);
    color: var(--ink-secondary);
    font-weight: 500;
    font-size: 0.95rem;
  }

  .nav-mobile-link:hover {
    color: var(--ink);
    background-color: var(--surface-subtle);
  }

  @media (max-width: 720px) {
    .nav-desktop {
      display: none;
    }

    .mobile-only {
      display: inline-flex;
    }
  }
</style>

<script>
  const themeBtn = document.getElementById('theme-toggle');
  themeBtn?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    localStorage.setItem('theme', next);
  });

  const langBtn = document.getElementById('lang-toggle');
  langBtn?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.getAttribute('data-lang') === 'de' ? 'en' : 'de';
    root.setAttribute('data-lang', next);
    root.setAttribute('lang', next);
    localStorage.setItem('lang', next);
    window.dispatchEvent(new CustomEvent('langchange', { detail: { lang: next } }));
  });

  const menuBtn = document.getElementById('mobile-menu-toggle');
  const mobileNav = document.getElementById('mobile-nav');
  menuBtn?.addEventListener('click', () => {
    if (!mobileNav) return;
    const isHidden = mobileNav.hasAttribute('hidden');
    if (isHidden) {
      mobileNav.removeAttribute('hidden');
      menuBtn.setAttribute('aria-expanded', 'true');
    } else {
      mobileNav.setAttribute('hidden', '');
      menuBtn.setAttribute('aria-expanded', 'false');
    }
  });

  mobileNav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      mobileNav.setAttribute('hidden', '');
      menuBtn?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
